# ScamSach backend settings.
# 1. Copy this file to a new file named .env (in this same backend folder).
# 2. Fill in values as you create each free account. Blank values are fine:
#    the app runs without them and simply skips that feature.
# 3. NEVER commit .env. It is listed in .gitignore.

ENVIRONMENT=development
# Website address(es) allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:3000
# Any long random text. Used to hash messages for the result cache.
CACHE_SECRET=change-me-to-a-long-random-string

# --- Abuse protection ----------------------------------------------------
# Checks per hour for visitors who are not logged in. Raise it on your own PC
# while testing (e.g. 100); keep 5 on the public server.
ANON_CHECKS_PER_HOUR=5
# Your Google-login e-mail(s), comma separated: these accounts skip the daily
# per-user limit so you can test freely on any device after logging in.
ADMIN_EMAILS=

# --- AI models (free tiers) ---------------------------------------------
# Google AI Studio -> Get API key   https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Groq Console -> API Keys           https://console.groq.com/keys
GROQ_API_KEY=
# Model names are tried in order; edit only if a check script says a model is gone.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct

# --- Threat intelligence (free, non-commercial) -------------------------
# Google Cloud Console -> enable "Safe Browsing API" -> Credentials -> API key
SAFE_BROWSING_API_KEY=
# virustotal.com -> sign up -> your profile -> API key
VIRUSTOTAL_API_KEY=
# auth.abuse.ch -> log in -> Optional -> generate Auth-Key
URLHAUS_AUTH_KEY=

# --- Supabase (database + Google login) ---------------------------------
# Project Settings -> API: Project URL, publishable (anon) key, secret (service_role) key
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Langfuse (agent tracing) --------------------------------------------
# cloud.langfuse.com -> project -> Settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
