# Copy this file to .env.local and fill in the values.
# Everything here is PUBLIC (it is shipped to the browser). Never put a secret key here.

# Where the backend API runs. Local: http://localhost:8000  Production: your Render URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (optional locally: leave blank and the site works without login)
# Use the Project URL and the *publishable* (anon) key, never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Search engines (optional). Public site address, and the Google Search Console
# "HTML tag" verification code (only the content="..." value; it is public by design).
NEXT_PUBLIC_SITE_URL=https://scamsach.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
